// =====================================================================
// FIRESTORE SECURITY RULES
// =====================================================================
// Paste these into Firebase Console → Firestore → Rules tab → Publish
//
// What this does:
//   - Only signed-in users can read or write your family document.
//   - Anyone you've added in Firebase Authentication has full access.
//   - Unauthenticated users get nothing.
//
// To restrict to specific emails (more secure), see the commented version
// at the bottom of this file.
// =====================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /families/{familyId} {
      allow read, write: if request.auth != null;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ---------------------------------------------------------------------
// MORE SECURE VERSION (recommended once you have things working)
// Replace the rule above with this once you know your auth emails:
// ---------------------------------------------------------------------
//
// match /families/{familyId} {
//   allow read, write: if request.auth != null && request.auth.token.email in [
//     'will@expertwealth.com.au',
//     'maryesquirol@gmail.com'
//   ];
// }
